---
import { STATE_DEFS, type MascotMark, type MascotState } from '../data/stations';

interface Props {
  color: string;
  mark: MascotMark;
  state?: MascotState;
  width?: number;
  height?: number;
}

const {
  color,
  mark,
  state = 'working',
  width = 78,
  height = 86
} = Astro.props;

const stDef = STATE_DEFS[state] || STATE_DEFS.working;
const orbColor = stDef.cssOrb;
const eyeType = stDef.eyes;
---

<svg
  class="mascot-fallback-svg"
  viewBox="0 0 120 134"
  width={width}
  height={height}
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  style="display:block;max-width:100%;height:auto;"
>
  <!-- Ground Shadow -->
  <ellipse cx="60" cy="127" rx="32" ry="4.5" fill="rgba(0,0,0,0.38)" />

  <!-- Arms -->
  <ellipse cx="13" cy="90" rx="7" ry="11" fill={color} />
  <ellipse cx="107" cy="90" rx="7" ry="11" fill={color} />

  <!-- Antenna -->
  <line x1="60" y1="30" x2="60" y2="17" stroke={color} stroke-width="3.2" stroke-linecap="round" />
  <!-- Orb glow & circle -->
  <circle cx="60" cy="11" r="14" fill={orbColor} opacity="0.3" />
  <circle cx="60" cy="11" r="7.8" fill={orbColor} />

  <!-- Body -->
  <path
    d="M60 28 C86 28 102 52 105 80 C108 106 92 118 60 118 C28 118 12 106 15 80 C18 52 34 28 60 28 Z"
    fill={color}
  />
  <!-- Bottom Shade -->
  <path
    d="M15 80 C12 106 28 118 60 118 C92 118 108 106 105 80 C97 98 80 106 60 106 C40 106 23 98 15 80 Z"
    fill="rgba(0,0,0,0.22)"
  />

  <!-- Chest Mark -->
  {mark === 'bar' && (
    <rect x="52" y="49.7" width="16" height="4.6" rx="2.3" fill="rgba(18,24,48,0.6)" />
  )}
  {mark === 'ring' && (
    <circle cx="60" cy="52" r="4.6" fill="none" stroke="rgba(18,24,48,0.6)" stroke-width="2.6" />
  )}
  {mark === 'diamond' && (
    <polygon points="60,45.5 66.5,52 60,58.5 53.5,52" fill="rgba(18,24,48,0.6)" />
  )}
  {mark === 'wave' && (
    <path d="M51 53 Q55.5 47 60 53 Q64.5 59 69 53" fill="none" stroke="rgba(18,24,48,0.6)" stroke-width="2.6" stroke-linecap="round" />
  )}
  {mark === 'tri' && (
    <polygon points="60,46.5 66,57 54,57" fill="rgba(18,24,48,0.6)" />
  )}

  <!-- Visor -->
  <rect x="25" y="70" width="70" height="32" rx="16" fill="#10131a" stroke="rgba(255,255,255,0.1)" stroke-width="1" />

  <!-- Eyes -->
  {eyeType === 'cap' && (
    <g fill={orbColor}>
      <rect x="41.5" y="78" width="7" height="16" rx="3.5" />
      <rect x="71.5" y="78" width="7" height="16" rx="3.5" />
    </g>
  )}
  {eyeType === 'round' && (
    <g fill={orbColor}>
      <circle cx="45" cy="86" r="6.5" />
      <circle cx="75" cy="86" r="6.5" />
    </g>
  )}
  {eyeType === 'happy' && (
    <g stroke={orbColor} stroke-width="4" stroke-linecap="round" fill="none">
      <path d="M39 90 Q45 79 51 90" />
      <path d="M69 90 Q75 79 81 90" />
    </g>
  )}
  {eyeType === 'x' && (
    <g stroke={orbColor} stroke-width="3.5" stroke-linecap="round">
      <line x1="41.5" y1="82" x2="48.5" y2="90" />
      <line x1="48.5" y1="82" x2="41.5" y2="90" />
      <line x1="71.5" y1="82" x2="78.5" y2="90" />
      <line x1="78.5" y1="82" x2="71.5" y2="90" />
    </g>
  )}
</svg>
