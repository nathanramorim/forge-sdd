---
import BaseLayout from '../layouts/BaseLayout.astro';
import SvgSprite from '../components/SvgSprite.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProcessSection from '../components/ProcessSection.astro';
import EmulatorSection from '../components/EmulatorSection.astro';
import InstallSection from '../components/InstallSection.astro';
import GovernanceSection from '../components/GovernanceSection.astro';
import EvolutionSection from '../components/EvolutionSection.astro';
import VideoSection from '../components/VideoSection.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <SvgSprite />
  <Header />

  <div class="wrap">
    <main>
      <Hero />
      <ProcessSection />
      <EmulatorSection />
      <InstallSection />
      <GovernanceSection />
      <EvolutionSection />
      <VideoSection />
    </main>
    <Footer />
  </div>

  <script src="../scripts/interactions.ts"></script>
</BaseLayout>
