{
  "cli": "claude",
  "permissions": "project",
  "terminal": "auto",
  "allow_commands": [
    "git",
    "gh",
    "forge-sdd"
  ],
  "cli_profiles": {
    "agy": {
      "command": "agy",
      "args": [
        "-p",
        "{prompt}",
        "{permissions}"
      ],
      "interactive_args": [
        "--agent",
        "{agent}",
        "-i"
      ]
    },
    "claude": {
      "command": "claude",
      "args": [
        "-p",
        "{prompt}",
        "--agent",
        "{agent}",
        "-n",
        "{name}",
        "--output-format",
        "stream-json",
        "--verbose",
        "{permissions}"
      ],
      "interactive_args": [
        "-n",
        "{name}",
        "--agent",
        "{agent}"
      ]
    },
    "codex": {
      "command": "codex",
      "args": [
        "exec",
        "--json",
        "{permissions}",
        "{prompt}"
      ],
      "interactive_args": [
        "{prompt}"
      ]
    },
    "copilot": {
      "command": "copilot",
      "args": [
        "-p",
        "{prompt}",
        "-n",
        "{name}",
        "--no-ask-user",
        "{permissions}"
      ],
      "interactive_args": [
        "-i",
        "{prompt}",
        "-n",
        "{name}"
      ]
    },
    "gemini": {
      "command": "agy",
      "args": [
        "-p",
        "{prompt}",
        "{permissions}"
      ],
      "interactive_args": [
        "-i",
        "{prompt}"
      ]
    }
  },
  "pm_mcp": {
    "provider": "auto",
    "supported": [
      "clickup",
      "github-projects",
      "azure-devops",
      "jira"
    ],
    "require_existing_card": true,
    "status_on_implement": "In Progress",
    "status_on_pr_approved": "Ready for Review",
    "evidence_max_age_minutes": 30
  },
  "builder": {
    "max_parallel_tasks": 3,
    "use_git_worktrees": true,
    "run_tests_before_pr": true,
    "job_timeout_minutes": 60
  },
  "reviewer": {
    "max_rework_attempts": 3,
    "comment_on_pr": true
  },
  "adr_dirs": [
    "sdd/spec/adr"
  ],
  "base_branch": "main"
}
