{
  "default_channel": "discovery_session",
  "channels": {
    "discovery_session": {
      "enabled": true,
      "desktop_toast": true
    },
    "email": {
      "enabled": false,
      "provider": "smtp",
      "host": "",
      "port": 587,
      "user_env": "",
